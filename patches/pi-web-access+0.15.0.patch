diff --git a/node_modules/pi-web-access/search-batch.ts b/node_modules/pi-web-access/search-batch.ts
new file mode 100644
index 0000000..ec2ec09
--- /dev/null
+++ b/node_modules/pi-web-access/search-batch.ts
@@ -0,0 +1,141 @@
+// Fan-out for a multi-query web_search call.
+//
+// One `web_search` with N queries used to be an indexed `for` loop with an
+// `await` inside: N sequential upstream round trips, each of which can be a full
+// model inference (the OpenAI/xAI backends post to a Responses endpoint and let
+// the provider's own hosted search tool run). With a 60s per-query timeout and no
+// ceiling on the call as a whole, a routine 4-query research request could hold a
+// turn for four minutes, and the tool schema actively encourages 2-4 queries.
+//
+// The queries are independent — each returns its own synthesized answer — so the
+// only reason they were serial was the shape of the loop. This runs them through
+// a small worker pool instead and gives the whole call a deadline:
+//
+//   - results stay in query order regardless of completion order,
+//   - a caller abort still aborts the batch (the tool call fails, as before),
+//   - the deadline does NOT: it stops starting new queries, cancels the in-flight
+//     ones, and returns what finished with an error string on the rest. A slow
+//     provider degrades the answer instead of hanging the turn.
+
+/** Concurrent upstream searches. Above ~4 the provider rate-limits are the wall. */
+export const DEFAULT_SEARCH_CONCURRENCY = 4;
+
+/**
+ * Ceiling for the whole call, across every wave. Per-query timeouts are 30-60s
+ * depending on backend, so a serial 4-query call could legitimately run past 4
+ * minutes; this bounds the tool call itself.
+ */
+export const DEFAULT_SEARCH_BUDGET_MS = 90_000;
+
+export interface SearchBatchEntry<T> {
+	query: string;
+	/** The backend's payload, or undefined when the query failed. */
+	value?: T;
+	error: string | null;
+}
+
+export interface SearchBatchDeps<T> {
+	/**
+	 * Run one query. The signal combines the caller's signal with the batch
+	 * deadline — pass it through to the backend so a blown budget actually
+	 * cancels the in-flight request rather than leaking it.
+	 */
+	search: (query: string, index: number, signal: AbortSignal) => Promise<T>;
+	/** Fired when a query starts and again when it settles. */
+	onProgress?: (state: { started: number; settled: number; total: number; query: string }) => void;
+}
+
+export interface SearchBatchOptions {
+	concurrency?: number;
+	budgetMs?: number;
+	signal?: AbortSignal;
+}
+
+function isAbortError(err: unknown): boolean {
+	return err instanceof Error && (err.name === "AbortError" || err.name === "TimeoutError");
+}
+
+/**
+ * Run every query concurrently (bounded), preserving input order in the result.
+ * Throws only when the caller's own signal aborts — every other failure, the
+ * deadline included, comes back as a per-query `error`.
+ */
+export async function runSearchBatch<T>(
+	queries: string[],
+	deps: SearchBatchDeps<T>,
+	options: SearchBatchOptions = {},
+): Promise<SearchBatchEntry<T>[]> {
+	const total = queries.length;
+	const entries: SearchBatchEntry<T>[] = queries.map((query) => ({ query, error: null }));
+	if (total === 0) return entries;
+
+	const budgetMs = options.budgetMs ?? DEFAULT_SEARCH_BUDGET_MS;
+	const concurrency = Math.max(1, Math.min(options.concurrency ?? DEFAULT_SEARCH_CONCURRENCY, total));
+
+	// Separate from the caller's signal on purpose: a blown deadline is a partial
+	// result, not a failed tool call, so the two aborts must stay distinguishable.
+	const deadline = new AbortController();
+	let deadlineFired = false;
+	const timer = setTimeout(() => {
+		deadlineFired = true;
+		deadline.abort();
+	}, budgetMs);
+	// Node keeps the process alive for a pending timer; a batch that finishes
+	// early should not hold the event loop open for the rest of the budget.
+	(timer as unknown as { unref?: () => void }).unref?.();
+
+	const signal = options.signal
+		? AbortSignal.any([options.signal, deadline.signal])
+		: deadline.signal;
+
+	let started = 0;
+	let settled = 0;
+	let next = 0;
+	let callerAborted: unknown;
+
+	const worker = async (): Promise<void> => {
+		for (;;) {
+			if (options.signal?.aborted || deadlineFired || callerAborted !== undefined) return;
+			const index = next++;
+			if (index >= total) return;
+			const query = queries[index];
+			started++;
+			deps.onProgress?.({ started, settled, total, query });
+			try {
+				entries[index].value = await deps.search(query, index, signal);
+			} catch (err) {
+				if (options.signal?.aborted || (isAbortError(err) && !deadlineFired)) {
+					// The turn itself was cancelled — surface it, don't paper over it.
+					callerAborted = err;
+					return;
+				}
+				entries[index].error = deadlineFired && isAbortError(err)
+					? `Search budget of ${Math.round(budgetMs / 1000)}s exceeded before this query finished`
+					: err instanceof Error ? err.message : String(err);
+			} finally {
+				settled++;
+				deps.onProgress?.({ started, settled, total, query });
+			}
+		}
+	};
+
+	try {
+		await Promise.all(Array.from({ length: concurrency }, () => worker()));
+	} finally {
+		clearTimeout(timer);
+	}
+
+	if (callerAborted !== undefined) throw callerAborted;
+
+	// Queries the deadline never let start still have to be accounted for, or the
+	// model silently believes it searched something it did not.
+	if (deadlineFired) {
+		for (const entry of entries) {
+			if (entry.value === undefined && entry.error === null) {
+				entry.error = `Search budget of ${Math.round(budgetMs / 1000)}s exceeded before this query started`;
+			}
+		}
+	}
+
+	return entries;
+}
