# Copy to `.env` beside docker-compose.yml and fill in. Docker Compose reads it
# automatically; nothing here is secret except by association, and the one real
# secret — the passphrase — lives in its own file (STEM_KEY_FILE) rather than in
# an environment variable anything can `docker inspect` back out.

# The public name. It must already point at this server's IP, because Caddy will
# ask Let's Encrypt for a certificate for it on the first boot.
STEM_HOSTNAME=stem.example.com

# Where the state root lives on the host: chats, memory, skills, Files,
# credentials. This is the directory to back up. Relative paths are relative to
# docker-compose.yml.
STEM_STATE_ROOT=./state

# The file holding the passphrase your archive was exported under. Make it with
#   printf '%s' 'the passphrase you exported under' > /root/stem/stem_key
#   chmod 600 /root/stem/stem_key
# A trailing newline is forgiven (`echo` and `printf` both work); anything else
# in the file is taken as part of the passphrase.
STEM_KEY_FILE=./stem_key

# linux/amd64 unless your server is arm (Hetzner CAX, Ampere, a Pi).
# STEM_PLATFORM=linux/arm64

# Node's heap ceiling for the main process. Raise it on a box with room; a 2 GB
# VPS is happier with the default.
# STEM_NODE_OPTIONS=--max-old-space-size=1024
