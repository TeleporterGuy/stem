
# Stem global relay (~/services/stem-relay, container stem-relay).
relay.stem.awantech.sk {
	import security_headers
	import cloudflare_dns
	# GET /v1/stream is SSE — never buffer it.
	reverse_proxy stem-relay:8080 {
		flush_interval -1
		stream_close_delay 5m
	}
	log {
		output stdout
		format console
	}
}

# heystem.app zone: separate Cloudflare token (Zone:Read + DNS:Edit on heystem.app,
# IP-filtered to this box), CLOUDFLARE_API_TOKEN_HEYSTEM in ~/services/caddy/.env
# and passed through docker-compose.yml.
(cloudflare_dns_heystem) {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN_HEYSTEM}
	}
}

# Stem global relay on the product domain (same container as relay.stem.awantech.sk).
relay.heystem.app {
	import security_headers
	import cloudflare_dns_heystem
	# GET /v1/stream is SSE — never buffer it.
	reverse_proxy stem-relay:8080 {
		flush_interval -1
		stream_close_delay 5m
	}
}

# Share-link viewer. stem-relay serves it all from ~/services/stem-relay/viewer
# (npm run build:share → dist/share, mounted at /viewer): /s/<id> with the
# share's link-preview tags filled in, the hashed assets, and /v1/shares/*.
# Nothing else of the relay API is reachable here. Its own origin, so shared
# content never runs where relay calls or a future heystem.app login do. The
# decryption key is in the URL fragment, which never reaches a server.
# noindex everywhere, but no robots.txt Disallow: that would stop the
# chat-app crawlers that draw link previews too.
share.heystem.app {
	import cloudflare_dns_heystem
	header {
		Content-Security-Policy "default-src 'none'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
		Referrer-Policy "no-referrer"
		X-Content-Type-Options "nosniff"
		X-Robots-Tag "noindex, nofollow, noarchive"
		Strict-Transport-Security "max-age=31536000"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}
	@viewer path /s/* /assets/* /og.png /favicon.png /v1/shares /v1/shares/*
	handle @viewer {
		reverse_proxy stem-relay:8080
	}
	handle / {
		redir https://heystem.app 302
	}
	handle {
		respond "Not found" 404
	}
}

# Homepage placeholder until the site exists.
heystem.app {
	import cloudflare_dns_heystem
	redir https://github.com/join3r/stem 302
}

www.heystem.app {
	import cloudflare_dns_heystem
	redir https://heystem.app{uri} 301
}
